{
  "name": "pasaporte-firebase-tests",
  "private": true,
  "type": "module",
  "description": "Pruebas de reglas de seguridad (Firestore/Storage) e integración de Cloud Functions contra los emuladores de Firebase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:rules": "node scripts/emulators-exec.mjs firestore,storage \"node --test --test-concurrency=1 rules/*.test.mjs\"",
    "pretest:integration": "npm --prefix ../../functions run build",
    "test:integration": "node scripts/emulators-exec.mjs auth,firestore,functions \"node --test --test-concurrency=1 integration/*.test.mjs\"",
    "test": "npm run test:rules && npm run test:integration"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0"
  }
}
